{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "outDir": "dist",

    // Node runs this TypeScript directly, so local imports keep their real
    // `.ts` extension. Without this, tsc rejects the very imports the runtime
    // requires.
    "allowImportingTsExtensions": true,

    // Surface unused code as an error rather than letting it accumulate.
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    // Treat an unchecked index access as possibly undefined. Testpilot spends
    // its life indexing into parsed diffs and graph lookups, where a missing
    // key is a real and likely case, not a theoretical one.
    "noUncheckedIndexedAccess": true
  },
  "include": ["src/**/*", "tests/**/*", "*.config.ts"]
}
