{
  "name": "testpilot-ci",
  "version": "0.1.0",
  "description": "Launchable-style test selection, but open-source, self-hostable, explainable, and working on day one — built on Mastra.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "testpilot": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/mastra/index.d.ts",
      "default": "./dist/mastra/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "ci",
    "test-selection",
    "test-impact-analysis",
    "flaky-tests",
    "mastra",
    "ai-agent"
  ],
  "homepage": "https://github.com/athul-2003/TestPilot",
  "bugs": {
    "url": "https://github.com/athul-2003/TestPilot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/athul-2003/TestPilot.git"
  },
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "start": "mastra start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "node --env-file=.env src/mastra/scorers/run-eval.ts",
    "build:dist": "tsc -p tsconfig.build.json",
    "prepack": "npm run build:dist"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@mastra/core": "1.59.0",
    "@mastra/libsql": "1.20.0",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "latest",
    "eslint": "^9.39.0",
    "mastra": "1.25.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
