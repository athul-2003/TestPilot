# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env
#
# `.env` is gitignored and must never be committed — it holds your real keys.
# This file is committed, and documents the shape of the config.

# --- Model providers --------------------------------------------------------
#
# Testpilot runs on two tiers. A fast, cheap model does the everyday work; a
# stronger one is held back for calls that have to be right. You only need a
# key for the providers you actually point at — set one, or both.
#
# Mastra's model router takes plain "provider/model" strings, so switching
# provider is a one-line change. That is deliberate: a tool that calls itself
# self-hostable should not be welded to one vendor.

# Groq — fast and cheap, the default for everyday runs.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI — used for ambiguous selection calls and evaluation runs.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Behaviour --------------------------------------------------------------

# The everyday working model. Testpilot runs on every pull request, so its own
# cost has to stay far below the CI time it saves.
#
# Verify IDs against the live list before changing these, since provider
# lineups move:
#   node .claude/skills/mastra/scripts/provider-registry.mjs --list
#   node .claude/skills/mastra/scripts/provider-registry.mjs --provider groq
# TESTPILOT_MODEL=groq/openai/gpt-oss-120b

# Reserved for genuinely ambiguous selection calls and evaluation runs — the
# numbers that end up in the README and have to survive scrutiny.
# TESTPILOT_MODEL_CRITICAL=openai/gpt-5.4-mini

# Below this confidence, Testpilot stops trusting its own selection and falls
# back to running the entire suite. Lower = more aggressive skipping = more
# minutes saved, but a higher chance of missing a regression.
# Starting value, pending calibration against the fixture repo.
# TESTPILOT_CONFIDENCE_THRESHOLD=0.7
